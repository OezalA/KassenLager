<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    x:Class="KassenLager.App.Views.Booking.BranchReturnFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:app="clr-namespace:KassenLager.App"
    xmlns:controls="clr-namespace:KassenLager.App.Controls"
    xmlns:domain="clr-namespace:KassenLager.Core.Domain;assembly=KassenLager.Core"
    xmlns:views="clr-namespace:KassenLager.App.Views"
    xmlns:vm="clr-namespace:KassenLager.App.ViewModels.Booking"
    x:DataType="vm:BranchReturnFormViewModel"
    Title="Rücknahme aus Filiale">

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="16,4,16,16">
                <Label Text="Kunde *" Style="{StaticResource FormLabel}" />
                <Picker Title="Kunde wählen" ItemsSource="{Binding Customers}"
                        ItemDisplayBinding="{Binding Name, x:DataType=domain:Customer}"
                        SelectedItem="{Binding SelectedCustomer}" />

                <Label Text="Filiale *" Style="{StaticResource FormLabel}" />
                <controls:BranchField BindingContext="{Binding Branch}" />

                <Label Text="Seriennummer *" Style="{StaticResource FormLabel}" />
                <Entry Text="{Binding SerialNumber}" MaxLength="{Binding SerialNumberMaxLength}" Placeholder="Seriennummer des Geräts" />
                <Border Style="{StaticResource Card}" Margin="0,6,0,0" Padding="12"
                        IsVisible="{Binding LookupText, Converter={StaticResource HasText}}">
                    <Label Text="{Binding LookupText}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsLookupWarning}" Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <VerticalStackLayout IsVisible="{Binding NeedsArticle}">
                    <Label Text="Artikel (Modell) *" Style="{StaticResource FormLabel}" />
                    <Border Style="{StaticResource SelectionField}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PickArticleCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Artikel wählen …" Style="{StaticResource Hint}" FontSize="16" VerticalOptions="Center"
                                   IsVisible="{Binding HasArticle, Converter={StaticResource InvertedBool}}" />
                            <VerticalStackLayout VerticalOptions="Center" IsVisible="{Binding HasArticle}">
                                <Label Text="{Binding SelectedArticle.Name}" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding SelectedArticle.ManufacturerAndModel}" Style="{StaticResource ItemSubtitle}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Style="{StaticResource Chevron}" Text="{x:Static app:Icons.ChevronRight}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Label Text="Zustand *" Style="{StaticResource FormLabel}" />
                <VerticalStackLayout>
                    <RadioButton Content="Gebraucht – funktionsfähig" GroupName="returnState" IsChecked="{Binding IsUsedWorking}" />
                    <RadioButton Content="Defekt" GroupName="returnState" IsChecked="{Binding IsDefective}" />
                </VerticalStackLayout>

                <Label Text="Ticketnummer" Style="{StaticResource FormLabel}" />
                <Entry Text="{Binding Reference}" MaxLength="{Binding ReferenceMaxLength}" />

                <Label Text="Datum" Style="{StaticResource FormLabel}" />
                <DatePicker Date="{Binding Date}" MaximumDate="{Binding MaximumDate}" Format="dd.MM.yyyy" />

                <Label Text="Notiz" Style="{StaticResource FormLabel}" />
                <Editor Text="{Binding Note}" MaxLength="{Binding NoteMaxLength}" AutoSize="TextChanges" MinimumHeightRequest="80" />
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Style="{StaticResource BottomBar}">
            <Button Text="Rücknahme buchen" Command="{Binding BookCommand}" />
        </VerticalStackLayout>
    </Grid>
</views:ContentPageBase>
