<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    x:Class="KassenLager.App.Views.Booking.BranchIssueFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:app="clr-namespace:KassenLager.App"
    xmlns:controls="clr-namespace:KassenLager.App.Controls"
    xmlns:domain="clr-namespace:KassenLager.Core.Domain;assembly=KassenLager.Core"
    xmlns:views="clr-namespace:KassenLager.App.Views"
    xmlns:vm="clr-namespace:KassenLager.App.ViewModels.Booking"
    x:DataType="vm:BranchIssueFormViewModel"
    Title="Ausgabe an Filiale">

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="16,4,16,16">
                <Label Text="Kunde *" Style="{StaticResource FormLabel}" />
                <Picker Title="Kunde wählen" ItemsSource="{Binding Customers}"
                        ItemDisplayBinding="{Binding Name, x:DataType=domain:Customer}"
                        SelectedItem="{Binding SelectedCustomer}" />

                <Label Text="Filiale *" Style="{StaticResource FormLabel}" />
                <controls:BranchField BindingContext="{Binding Branch}" />

                <Label Text="Gerät aus dem Lager *" Style="{StaticResource FormLabel}" />
                <Border Style="{StaticResource SelectionField}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickDeviceCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Gerät wählen …" Style="{StaticResource Hint}" FontSize="16" VerticalOptions="Center"
                               IsVisible="{Binding HasDevice, Converter={StaticResource InvertedBool}}" />
                        <VerticalStackLayout VerticalOptions="Center" IsVisible="{Binding HasDevice}">
                            <Label Text="{Binding SelectedDevice.SerialNumber, StringFormat='SN {0}'}" FontFamily="OpenSansSemibold" />
                            <Label Text="{Binding SelectedDevice.ArticleText}" Style="{StaticResource ItemSubtitle}" />
                            <Label Text="{Binding SelectedDevice.StateName}" Style="{StaticResource ItemSubtitle}" FontSize="13" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Style="{StaticResource Chevron}" Text="{x:Static app:Icons.ChevronRight}" />
                    </Grid>
                </Border>

                <Label Text="Art *" Style="{StaticResource FormLabel}" />
                <HorizontalStackLayout Spacing="16">
                    <RadioButton Content="Leihgerät" GroupName="issueKind" IsChecked="{Binding IsLoan}" />
                    <RadioButton Content="Dauerhafter Einbau" GroupName="issueKind" IsChecked="{Binding IsPermanent}" />
                </HorizontalStackLayout>

                <Label Text="{Binding CustomerDeviceSerialLabel}" Style="{StaticResource FormLabel}" />
                <Entry Text="{Binding CustomerDeviceSerial}" MaxLength="{Binding CustomerDeviceSerialMaxLength}"
                       Placeholder="Seriennummer des ausgebauten Geräts" />

                <Label Text="Modell Kundengerät" Style="{StaticResource FormLabel}" />
                <Entry Text="{Binding CustomerDeviceModel}" MaxLength="{Binding CustomerDeviceModelMaxLength}" />

                <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="52" Margin="0,8,0,0">
                    <Label Text="Kundengerät bereits an Zentrale gesendet" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding IsCustomerDeviceSent}" />
                </Grid>
                <DatePicker Date="{Binding CustomerDeviceSentDate}" MaximumDate="{Binding MaximumDate}" Format="dd.MM.yyyy"
                            IsVisible="{Binding IsCustomerDeviceSent}" />
                <Label Style="{StaticResource Hint}" Text="Das Versanddatum kann auch später in der Ausgabe nachgetragen werden." />

                <Label Text="Ticketnummer" Style="{StaticResource FormLabel}" />
                <Entry Text="{Binding Reference}" MaxLength="{Binding ReferenceMaxLength}" />

                <Label Text="Datum" Style="{StaticResource FormLabel}" />
                <DatePicker Date="{Binding Date}" MaximumDate="{Binding MaximumDate}" Format="dd.MM.yyyy" />

                <Label Text="Notiz" Style="{StaticResource FormLabel}" />
                <Editor Text="{Binding Note}" MaxLength="{Binding NoteMaxLength}" AutoSize="TextChanges" MinimumHeightRequest="80" />
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Style="{StaticResource BottomBar}">
            <Button Text="Ausgabe buchen" Command="{Binding BookCommand}" />
        </VerticalStackLayout>
    </Grid>
</views:ContentPageBase>
