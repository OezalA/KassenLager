<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KassenLager.App.Views.MorePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:app="clr-namespace:KassenLager.App"
    xmlns:controls="clr-namespace:KassenLager.App.Controls"
    xmlns:vm="clr-namespace:KassenLager.App.ViewModels"
    x:DataType="vm:MoreViewModel"
    Title="Mehr">

    <ScrollView>
        <VerticalStackLayout Padding="0,0,0,24">
            <Label Text="Bestand" Style="{StaticResource SectionHeader}" />
            <controls:MenuRow Icon="{x:Static app:Icons.Stock}" Text="Bestand je Kunde"
                              Detail="Nach Kategorien, unter Mindestbestand, defekt" Command="{Binding OpenCustomerStockCommand}" />
            <controls:MenuRow Icon="{x:Static app:Icons.Devices}" Text="Geräte"
                              Detail="Alle Geräte mit Seriennummer und Verlauf"
                              Command="{Binding OpenRouteCommand}" CommandParameter="{x:Static app:Routes.Devices}" />
            <controls:MenuRow Icon="{x:Static app:Icons.BranchIssues}" Text="Ausgaben"
                              Detail="An Filialen ausgegebene Geräte"
                              Command="{Binding OpenRouteCommand}" CommandParameter="{x:Static app:Routes.BranchIssues}" />
            <controls:MenuRow Icon="{x:Static app:Icons.Journal}" Text="Buchungsjournal"
                              Detail="Alle Buchungen, Storno"
                              Command="{Binding OpenRouteCommand}" CommandParameter="{x:Static app:Routes.Movements}" />

            <Label Text="Bestellung" Style="{StaticResource SectionHeader}" />
            <controls:MenuRow Icon="{x:Static app:Icons.OrderSuggestion}" Text="Bestellvorschlag"
                              Detail="Artikel unter Mindestbestand je Kunde"
                              Command="{Binding OpenRouteCommand}" CommandParameter="{x:Static app:Routes.OrderSuggestion}" />
            <controls:MenuRow Icon="{x:Static app:Icons.Orders}" Text="Bestellungen"
                              Detail="Bestellungen an die Zentrale, Wareneingang aus Bestellung"
                              Command="{Binding OpenRouteCommand}" CommandParameter="{x:Static app:Routes.Orders}" />

            <Label Text="Stammdaten" Style="{StaticResource SectionHeader}" />
            <controls:MenuRow Icon="{x:Static app:Icons.Article}" Text="Artikel"
                              Detail="Modelle, Ersatzteile und Material, Mindestbestand"
                              Command="{Binding OpenRouteCommand}" CommandParameter="{x:Static app:Routes.Articles}" />

            <Label Text="Daten" Style="{StaticResource SectionHeader}" />
            <controls:MenuRow Icon="{x:Static app:Icons.Data}" Text="Import, Export, Sicherung"
                              Detail="Excel-Import, Excel-Listen, Datensicherung"
                              Command="{Binding OpenRouteCommand}" CommandParameter="{x:Static app:Routes.Data}" />

            <Label Text="App" Style="{StaticResource SectionHeader}" />
            <controls:MenuRow Icon="{x:Static app:Icons.Settings}" Text="Einstellungen"
                              Detail="Kunden, Kategorien, Einheiten, Benutzername, Darstellung"
                              Command="{Binding OpenRouteCommand}" CommandParameter="{x:Static app:Routes.Settings}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
