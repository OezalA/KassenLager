<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    x:Class="KassenLager.App.Views.Movements.MovementListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:KassenLager.App.Controls"
    xmlns:services="clr-namespace:KassenLager.Core.Services;assembly=KassenLager.Core"
    xmlns:shared="clr-namespace:KassenLager.App.ViewModels"
    xmlns:views="clr-namespace:KassenLager.App.Views"
    xmlns:vm="clr-namespace:KassenLager.App.ViewModels.Movements"
    x:DataType="vm:MovementListViewModel"
    Title="Buchungsjournal">

    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Padding="16,0">
            <Picker Title="Kunde" ItemsSource="{Binding CustomerFilters}"
                    ItemDisplayBinding="{Binding Name, x:DataType=shared:CustomerFilter}"
                    SelectedItem="{Binding SelectedCustomerFilter}" />
            <Picker Grid.Column="1" Title="Buchungsart" ItemsSource="{Binding TypeFilters}"
                    ItemDisplayBinding="{Binding Name, x:DataType=shared:TypeFilter}"
                    SelectedItem="{Binding SelectedTypeFilter}" />
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Keine Buchungen." Style="{StaticResource Hint}" HorizontalOptions="Center" Margin="24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:MovementListItem">
                    <controls:MovementRow Item="{Binding .}"
                                          Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:MovementListViewModel}}, x:DataType=vm:MovementListViewModel}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <Button Text="Weitere laden" Style="{StaticResource SecondaryButton}" Margin="16,12"
                        Command="{Binding LoadMoreCommand}" IsVisible="{Binding HasMore}" />
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</views:ContentPageBase>
