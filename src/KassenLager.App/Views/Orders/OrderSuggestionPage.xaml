<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    x:Class="KassenLager.App.Views.Orders.OrderSuggestionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:domain="clr-namespace:KassenLager.Core.Domain;assembly=KassenLager.Core"
    xmlns:views="clr-namespace:KassenLager.App.Views"
    xmlns:vm="clr-namespace:KassenLager.App.ViewModels.Orders"
    x:DataType="vm:OrderSuggestionViewModel"
    Title="Bestellvorschlag">

    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Padding="16,0,16,4">
            <Picker Title="Kunde wählen" ItemsSource="{Binding Customers}"
                    ItemDisplayBinding="{Binding Name, x:DataType=domain:Customer}"
                    SelectedItem="{Binding SelectedCustomer}" />
            <Label Text="{Binding SummaryText}" Style="{StaticResource Hint}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Rows}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SuggestionRow">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,80">
                            <CheckBox IsChecked="{Binding IsIncluded}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Suggestion.ArticleName}" Style="{StaticResource ItemTitle}" FontSize="16" />
                                <Label Text="{Binding Suggestion.ManufacturerAndModel}" Style="{StaticResource ItemSubtitle}"
                                       IsVisible="{Binding Suggestion.ManufacturerAndModel, Converter={StaticResource HasText}}" />
                                <Label Text="{Binding Suggestion.DetailText}" Style="{StaticResource ItemSubtitle}" FontSize="13" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                <Entry Text="{Binding QuantityText}" Keyboard="Numeric" HorizontalTextAlignment="End" />
                                <Label Text="{Binding Suggestion.UnitName}" Style="{StaticResource Hint}" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Style="{StaticResource BottomBar}" IsVisible="{Binding HasRows}">
            <Button Text="Bestellentwurf anlegen" Command="{Binding CreateOrderCommand}" />
        </VerticalStackLayout>
    </Grid>
</views:ContentPageBase>
