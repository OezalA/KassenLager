<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    x:Class="KassenLager.App.Views.Pickers.ArticlePickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:KassenLager.App.Views"
    xmlns:vm="clr-namespace:KassenLager.App.ViewModels.Pickers"
    x:DataType="vm:ArticlePickerViewModel"
    Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*">
        <SearchBar Text="{Binding FilterText}" Placeholder="Bezeichnung, Modell, Hersteller, Nr. …" Margin="8,4,8,0" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Keine passenden Artikel. Neue Artikel unter Mehr → Artikel anlegen."
                       Style="{StaticResource Hint}" HorizontalTextAlignment="Center" Margin="24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ArticlePickerRow">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SelectCommand, Source={RelativeSource AncestorType={x:Type vm:ArticlePickerViewModel}}, x:DataType=vm:ArticlePickerViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Article.Name}" Style="{StaticResource ItemTitle}" />
                                <Label Text="{Binding Article.ManufacturerAndModel}" Style="{StaticResource ItemSubtitle}"
                                       IsVisible="{Binding Article.ManufacturerAndModel, Converter={StaticResource HasText}}" />
                                <Label Text="{Binding Article.CategoryName}" Style="{StaticResource ItemSubtitle}" FontSize="13" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding StockText}" Style="{StaticResource ItemSubtitle}" VerticalOptions="Center"
                                   IsVisible="{Binding StockText, Converter={StaticResource HasText}}" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</views:ContentPageBase>
