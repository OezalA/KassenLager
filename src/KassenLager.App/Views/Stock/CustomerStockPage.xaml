<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    x:Class="KassenLager.App.Views.Stock.CustomerStockPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:app="clr-namespace:KassenLager.App"
    xmlns:controls="clr-namespace:KassenLager.App.Controls"
    xmlns:services="clr-namespace:KassenLager.Core.Services;assembly=KassenLager.Core"
    xmlns:views="clr-namespace:KassenLager.App.Views"
    xmlns:vm="clr-namespace:KassenLager.App.ViewModels.Stock"
    x:DataType="vm:CustomerStockViewModel"
    Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="16,4,8,0">
            <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48">
                <Label Text="Nur unter Mindestbestand" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding BelowMinimumOnly}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48">
                <Label Text="Nur mit defekten Geräten" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding DefectiveOnly}" />
            </Grid>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Groups}" IsGrouped="True" SelectionMode="None">
            <CollectionView.Header>
                <Label Text="{Binding SummaryText}" Style="{StaticResource Hint}" Margin="16,8,16,0" />
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Label Text="Kein Bestand." Style="{StaticResource Hint}" HorizontalOptions="Center" Margin="24" />
            </CollectionView.EmptyView>
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:StockGroup">
                    <Label Text="{Binding Name}" Style="{StaticResource SectionHeader}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:StockLine">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="*,Auto,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:CustomerStockViewModel}}, x:DataType=vm:CustomerStockViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding ArticleName}" Style="{StaticResource ItemTitle}" />
                                <Label Text="{Binding ManufacturerAndModel}" Style="{StaticResource ItemSubtitle}"
                                       IsVisible="{Binding ManufacturerAndModel, Converter={StaticResource HasText}}" />
                                <Label Text="{Binding MinimumText}" Style="{StaticResource ItemSubtitle}" FontSize="13"
                                       IsVisible="{Binding MinimumText, Converter={StaticResource HasText}}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding StockText}" FontFamily="OpenSansSemibold" HorizontalOptions="End" />
                                <controls:Badge Text="unter Minimum" IsDanger="True" HorizontalOptions="End" IsVisible="{Binding IsBelowMinimum}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{StaticResource Chevron}" Text="{x:Static app:Icons.ChevronRight}" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</views:ContentPageBase>
