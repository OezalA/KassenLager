<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KassenLager.App.Views.InventoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:app="clr-namespace:KassenLager.App"
    Title="Inventur">

    <VerticalStackLayout Padding="32" Spacing="12" VerticalOptions="Center">
        <Label Style="{StaticResource Icon}" Text="{x:Static app:Icons.Inventory}" FontSize="48" HorizontalOptions="Center" />
        <Label Text="Inventur" FontSize="22" FontFamily="OpenSansSemibold" HorizontalOptions="Center" />
        <Label Style="{StaticResource Hint}" HorizontalTextAlignment="Center"
               Text="Zählung per Seriennummer und Menge mit Inventurbericht als Excel-Datei – folgt in einer späteren Version." />
    </VerticalStackLayout>
</ContentPage>
