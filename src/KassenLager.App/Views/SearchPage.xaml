<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KassenLager.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:app="clr-namespace:KassenLager.App"
    Title="Suche">

    <VerticalStackLayout Padding="32" Spacing="12" VerticalOptions="Center">
        <Label Style="{StaticResource Icon}" Text="{x:Static app:Icons.Search}" FontSize="48" HorizontalOptions="Center" />
        <Label Text="Suche" FontSize="22" FontFamily="OpenSansSemibold" HorizontalOptions="Center" />
        <Label Style="{StaticResource Hint}" HorizontalTextAlignment="Center"
               Text="Suche nach Modell, Hersteller, Bezeichnung, Artikelnummer, EAN und Seriennummer mit Bestand je Kunde – folgt mit dem nächsten Update." />
    </VerticalStackLayout>
</ContentPage>
