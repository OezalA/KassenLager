<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase
    x:Class="KassenLager.App.Views.Units.UnitListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:services="clr-namespace:KassenLager.Core.Services;assembly=KassenLager.Core"
    xmlns:views="clr-namespace:KassenLager.App.Views"
    xmlns:vm="clr-namespace:KassenLager.App.ViewModels.Units"
    x:DataType="vm:UnitListViewModel"
    Title="Einheiten">

    <Grid RowDefinitions="*,Auto">
        <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:UnitSummary">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:UnitListViewModel}}, x:DataType=vm:UnitListViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding Name}" Style="{StaticResource ItemTitle}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding ArticleCount, StringFormat='{0} Artikel'}"
                                   Style="{StaticResource ItemSubtitle}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="1" Style="{StaticResource BottomBar}">
            <Label Style="{StaticResource Hint}" Text="Tippen zum Umbenennen oder Löschen." HorizontalOptions="Center" />
            <Button Text="Neue Einheit" Command="{Binding AddCommand}" />
        </VerticalStackLayout>
    </Grid>
</views:ContentPageBase>
