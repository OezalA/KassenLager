<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- Offline by design: no INTERNET permission in release builds, and no Android
	     auto-backup to the cloud. Backups are explicit exports made by the user. -->
	<!-- Only Android 8–12 needs this for "Auf dem Gerät speichern"; newer versions use the system folder picker. -->
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
	<application
		android:allowBackup="false"
		android:fullBackupContent="false"
		android:icon="@mipmap/appicon"
		android:roundIcon="@mipmap/appicon_round"
		android:supportsRtl="true"></application>
</manifest>
